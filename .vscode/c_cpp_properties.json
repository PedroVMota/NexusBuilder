{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/Include",
                "${workspaceFolder}/lib/glfw/include",
                "${workspaceFolder}/lib/imgui",
                "${workspaceFolder}/lib/imgui/backends",
                "${workspaceFolder}/lib/glm",
                "/usr/include/GL",
                "/usr/include"
